---
import { Image } from 'astro:assets';

import SectionHeading from '../components/SectionHeading.astro';
import SiteHeader from '../components/SiteHeader.astro';
import profilePhoto from '../assets/nazmus-sakib-abir.jpg';
import {
  aboutPoints,
  contributionCards,
  credentials,
  experiences,
  profile,
  projects,
  publications,
  skillGroups,
  socialLinks,
} from '../data/portfolio';
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = `${profile.name} — AI/ML Engineer`;
---

<BaseLayout title={pageTitle} description={profile.summary}>
  <SiteHeader />

  <main id="top">
    <section class="intro container" aria-labelledby="intro-title">
      <div class="intro-copy">
        <p class="role-label">{profile.role}</p>
        <h1 id="intro-title">{profile.name}</h1>
        <p class="intro-summary">{profile.summary}</p>
        <p class="intro-detail">{profile.detail}</p>
        <p class="intro-proof">
          {profile.patentHighlight.lead}{' '}
          <strong>{profile.patentHighlight.emphasis}</strong>,{' '}
          {profile.patentHighlight.detail}
        </p>
        <ul class="intro-meta" aria-label="Profile details">
          <li>
            <svg
              width="15"
              height="15"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              aria-hidden="true"
            >
              <path d="M12 21s7-5.2 7-12A7 7 0 0 0 5 9c0 6.8 7 12 7 12Z"></path>
              <circle cx="12" cy="9" r="2"></circle>
            </svg>
            {profile.location}
          </li>
          <li>
            <svg
              width="15"
              height="15"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              aria-hidden="true"
            >
              <rect x="3" y="6" width="18" height="14" rx="2"></rect>
              <path d="M8 6V4h8v2"></path>
            </svg>
            {profile.employer}
          </li>
          <li>
            <svg
              width="15"
              height="15"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              aria-hidden="true"
            >
              <path d="M4 5h16v14H4zM4 7l8 6 8-6"></path>
            </svg>
            {profile.email}
          </li>
        </ul>
      </div>

      <div class="profile-column">
        <div class="portrait">
          <Image
            class="portrait-image"
            src={profilePhoto}
            alt="Nazmus Sakib Abir"
            width={680}
            height={680}
            format="webp"
            quality={85}
            loading="eager"
            fetchpriority="high"
          />
        </div>
        <div class="social-row" aria-label="Professional profiles">
          {
            socialLinks.map((social) => (
              <a class="social-card" href={social.href}>
                <span class="social-icon" aria-hidden="true">
                  {social.label === 'LinkedIn' ? (
                    'in'
                  ) : (
                    <svg viewBox="0 0 24 24" fill="currentColor">
                      <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.084-.729.084-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.381 1.235-3.221-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23a11.5 11.5 0 0 1 3.003-.404c1.02.005 2.045.138 3.003.404 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.911 1.23 3.221 0 4.61-2.805 5.625-5.475 5.921.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297 24 5.67 18.627.297 12 .297z" />
                    </svg>
                  )}
                </span>
                <span class="social-copy">
                  <strong>{social.label}</strong>
                  <span>{social.handle}</span>
                </span>
                <span class="social-arrow" aria-hidden="true">
                  ↗
                </span>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section container" id="about" aria-labelledby="about-title">
      <SectionHeading
        title="About"
        description="A concise view of the capabilities and working style developed across applied AI, software engineering, and technical-development leadership."
      />
      <ul class="offset-content about-list">
        {aboutPoints.map((point) => <li>{point}</li>)}
      </ul>
    </section>

    <section
      class="section container"
      id="experience"
      aria-labelledby="experience-title"
    >
      <SectionHeading
        title="Experience"
        description="Professional roles and the scope of work carried in each organization."
      />
      <div class="offset-content experience-timeline">
        {
          experiences.map((experience, index) => (
            <article class:list={['experience-card', { previous: index > 0 }]}>
              <div class="experience-top">
                <div>
                  <span class="experience-status">{experience.status}</span>
                  <h3>{experience.organization}</h3>
                  <p class="experience-role">{experience.role}</p>
                </div>
                <time class="experience-period">{experience.period}</time>
              </div>
              <p class="experience-summary">{experience.summary}</p>
              <ul class="experience-points">
                {experience.highlights.map((highlight) => (
                  <li>{highlight}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </section>

    <section
      class="section container"
      id="projects"
      aria-labelledby="projects-title"
    >
      <SectionHeading
        title="Projects"
        count={projects.length}
        description="High-level summaries of personal responsibilities and contributions. Client and internal implementation details are intentionally omitted."
      />
      <div class="offset-content projects-grid">
        {
          projects.map((project) => (
            <article class="project-card">
              <div class="project-top">
                <h3>{project.title}</h3>
                <time>{project.period}</time>
              </div>
              <p>{project.summary}</p>
              <ul class="tag-list" aria-label={`${project.title} technologies`}>
                {project.tags.map((tag) => (
                  <li>{tag}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </section>

    <section
      class="section container"
      id="skills"
      aria-labelledby="skills-title"
    >
      <SectionHeading
        title="Technical skills"
        description="Grouped by working area to show how the technologies fit into complete AI systems."
      />
      <div class="offset-content skills-grid">
        {
          skillGroups.map((group) => (
            <article class="skill-group">
              <h3>{group.title}</h3>
              <ul class="skill-items">
                {group.skills.map((skill) => (
                  <li>{skill}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </section>

    <section
      class="section container"
      id="public-work"
      aria-labelledby="public-work-title"
    >
      <SectionHeading
        title="Public work"
        description="Published technical writing and public, high-level demonstrations connected to recent work."
      />
      <div class="offset-content writing-grid">
        {
          publications.map((publication) => (
            <article class="article-card">
              <span class="article-type">{publication.type}</span>
              <h3>{publication.title}</h3>
              <div class="article-meta">
                <span>{publication.year}</span>
                <div class="article-links">
                  {publication.links.map((link) => (
                    <a href={link.href}>{link.label} ↗</a>
                  ))}
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="section container" aria-labelledby="contribution-title">
      <SectionHeading
        title="Teaching & contribution"
        description="Work that supports other engineers, students, and the broader organization."
      />
      <div class="offset-content support-grid">
        {
          contributionCards.map((card) => (
            <article class="support-card">
              <h3>{card.title}</h3>
              <p>{card.summary}</p>
              <ul>
                {card.points.map((point) => (
                  <li>{point}</li>
                ))}
              </ul>
              {card.link && (
                <a class="support-link" href={card.link.href}>
                  {card.link.label} <span aria-hidden="true">↗</span>
                </a>
              )}
            </article>
          ))
        }
      </div>
    </section>

    <section class="section container" aria-labelledby="credentials-title">
      <SectionHeading
        title="Education & certification"
        description="Formal academic background and current cloud credential."
      />
      <div class="offset-content credentials-grid">
        {
          credentials.map((credential) => (
            <article class="credential-card">
              <span class="credential-marker" aria-hidden="true">
                {credential.marker}
              </span>
              <h3>{credential.title}</h3>
              <p>{credential.detail}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section
      class="contact-section container"
      id="contact"
      aria-labelledby="contact-title"
    >
      <h2 id="contact-title">Contact</h2>
      <div class="contact-content">
        <p>
          Professional enquiries and hiring conversations can be sent through
          email or either professional profile.
        </p>
        <div class="contact-options">
          <a href={`mailto:${profile.email}`}>
            <strong>Email</strong>
            <span>{profile.email}</span>
          </a>
          {
            socialLinks.map((social) => (
              <a href={social.href}>
                <strong>{social.label}</strong>
                <span>{social.handle} ↗</span>
              </a>
            ))
          }
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer container">
    <strong>{profile.name} · AI/ML Engineer</strong>
    <span
      >BSc in EEE, BRAC University · Google Cloud Associate Cloud Engineer</span
    >
  </footer>
</BaseLayout>
