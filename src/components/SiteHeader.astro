---
import { navigation, profile } from '../data/portfolio';

const cvUrl = `${import.meta.env.BASE_URL}cv/Nazmus-Sakib-Abir-CV.pdf`;
---

<header class="site-header">
  <nav class="nav container" aria-label="Primary navigation">
    <a class="brand" href="#top" aria-label={`${profile.name}, back to top`}>
      <span class="brand-mark" aria-hidden="true">&gt;_</span>
      <span class="brand-name">{profile.name}</span>
    </a>
    <div class="nav-links">
      {
        navigation.map((item) => (
          <a href={item.href} data-section-link>
            {item.label}
          </a>
        ))
      }
      <a
        class="resume-link"
        href={cvUrl}
        download="Nazmus-Sakib-Abir-CV.pdf"
        aria-label="Download Nazmus Sakib Abir's CV as a PDF"
      >
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          aria-hidden="true"
        >
          <path d="M12 3v11"></path>
          <path d="m7.5 10 4.5 4.5 4.5-4.5"></path>
          <path d="M5 20h14"></path>
        </svg>
        <span class="resume-link-full" aria-hidden="true">Download CV</span>
        <span class="resume-link-short" aria-hidden="true">CV</span>
      </a>
      <a class="contact-link" href="#contact" data-section-link>Contact</a>
      <button
        class="theme-toggle"
        type="button"
        aria-label="Switch to light mode"
        aria-pressed="false"
        data-theme-toggle
      >
        <span class="theme-toggle-icon theme-toggle-sun" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <circle cx="12" cy="12" r="3.5"></circle>
            <path
              d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
            ></path>
          </svg>
        </span>
        <span class="theme-toggle-icon theme-toggle-moon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <path d="M20 15.5A8.5 8.5 0 0 1 8.5 4 8.5 8.5 0 1 0 20 15.5Z"
            ></path>
          </svg>
        </span>
      </button>
    </div>
  </nav>
</header>

<script>
  const themeStorageKey = 'portfolio-theme';
  const rootElement = document.documentElement;
  const themeToggle = document.querySelector<HTMLButtonElement>(
    '[data-theme-toggle]',
  );
  const systemTheme = window.matchMedia('(prefers-color-scheme: light)');
  const brand = document.querySelector<HTMLElement>('.brand');
  const introTitle = document.querySelector<HTMLElement>('#intro-title');

  let hasSavedTheme = false;

  try {
    hasSavedTheme = ['light', 'dark'].includes(
      window.localStorage.getItem(themeStorageKey) ?? '',
    );
  } catch {
    hasSavedTheme = false;
  }

  const applyTheme = (theme: 'light' | 'dark', persist = false) => {
    rootElement.dataset.theme = theme;
    document
      .querySelector<HTMLMetaElement>('#theme-color')
      ?.setAttribute('content', theme === 'light' ? '#f4f7fb' : '#0e1117');

    if (themeToggle) {
      const nextTheme = theme === 'light' ? 'dark' : 'light';
      themeToggle.setAttribute('aria-label', `Switch to ${nextTheme} mode`);
      themeToggle.setAttribute('title', `Switch to ${nextTheme} mode`);
      themeToggle.setAttribute('aria-pressed', String(theme === 'light'));
    }

    if (persist) {
      hasSavedTheme = true;
      try {
        window.localStorage.setItem(themeStorageKey, theme);
      } catch {
        // The selected theme still applies for the current page.
      }
    }
  };

  applyTheme(rootElement.dataset.theme === 'light' ? 'light' : 'dark');

  themeToggle?.addEventListener('click', () => {
    applyTheme(rootElement.dataset.theme === 'light' ? 'dark' : 'light', true);
  });

  systemTheme.addEventListener('change', (event) => {
    if (!hasSavedTheme) {
      applyTheme(event.matches ? 'light' : 'dark');
    }
  });

  if (brand && introTitle) {
    const updateBrandName = (showName: boolean) => {
      brand.classList.toggle('brand-name-visible', showName);
    };

    const introTitleObserver = new IntersectionObserver(
      ([entry]) => updateBrandName(!entry.isIntersecting),
      { rootMargin: '-64px 0px 0px' },
    );

    introTitleObserver.observe(introTitle);
  }

  const sectionLinks = Array.from(
    document.querySelectorAll<HTMLAnchorElement>('[data-section-link]'),
  );
  const linkedSections = sectionLinks
    .map((link) => {
      const id = link.hash.slice(1);
      const section = id ? document.getElementById(id) : null;
      return section ? { link, section } : null;
    })
    .filter(
      (entry): entry is { link: HTMLAnchorElement; section: HTMLElement } =>
        entry !== null,
    );

  if (linkedSections.length) {
    const updateActiveLink = () => {
      const activationLine = window.innerHeight * 0.36;
      let activeEntry: (typeof linkedSections)[number] | null = null;

      linkedSections.forEach((entry) => {
        if (entry.section.getBoundingClientRect().top <= activationLine) {
          activeEntry = entry;
        }
      });

      linkedSections.forEach(({ link }) => {
        const isActive = link === activeEntry?.link;
        link.classList.toggle('is-active', isActive);
        if (isActive) {
          link.setAttribute('aria-current', 'location');
        } else {
          link.removeAttribute('aria-current');
        }
      });
    };

    let navigationFrame = 0;
    const queueActiveLinkUpdate = () => {
      window.cancelAnimationFrame(navigationFrame);
      navigationFrame = window.requestAnimationFrame(updateActiveLink);
    };

    window.addEventListener('scroll', queueActiveLinkUpdate, { passive: true });
    window.addEventListener('resize', queueActiveLinkUpdate);
    updateActiveLink();
  }
</script>
